# Copy to .env in this directory. Do not commit the populated .env file.

# Required application/database settings.
# Supabase: copy the Session pooler connection string from Connect > ORMs.
# Keep sslmode=require and use the session pooler/direct connection for migrations.
APP_NAME=Duka Retail System
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://retailshop-information-system.vercel.app
DATABASE_URL=postgresql+psycopg://postgres:replace-me@db.project-ref.supabase.co:5432/postgres?sslmode=require
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Required for pytest; use a separate disposable PostgreSQL database.
# Do not point this at the same Supabase database as DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://retail_user:replace-me@localhost:5432/retail_test_db

# Daraja settings. Leave credentials empty to disable STK Push until configured.
# Use sandbox credentials and a publicly reachable HTTPS callback URL for development.
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
